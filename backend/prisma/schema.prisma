// Second Brain — Prisma schema
//
// Changes from the original:
//   - Content: added status/error/filePath/contentHash so the app can track
//     per-item ingestion progress instead of assuming every save succeeds instantly.
//   - `type` stays a String (not an enum) so existing "youtube" / "twitter" / "other"
//     rows keep working with no data migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  email    String    @unique
  password String
  contents Content[]
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Content {
  id          Int              @id @default(autoincrement())
  title       String
  link        String? // null when the content was uploaded as a file
  filePath    String? // set for uploaded files (PDF, markdown, image, audio)
  description String
  tags        String
  type        String // youtube | twitter | article | pdf | markdown | image | audio | github | url
  status      ProcessingStatus @default(PENDING)
  error       String?
  contentHash String? // dedupe / detect unchanged content on re-processing
  createdAt   DateTime         @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
